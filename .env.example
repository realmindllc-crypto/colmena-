# ========================================
# PROYECTO COLMENA - Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ========================================
# LLM Configuration
# ========================================
OPENAI_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ========================================
# Financial Data APIs
# ========================================
# yfinance (free, no key needed)
YFINANCE_ENABLED=true

# Alpha Vantage (optional, free tier available)
ALPHA_VANTAGE_KEY=
ALPHA_VANTAGE_ENABLED=false

# Interactive Brokers (Phase 6+)
IB_ACCOUNT=
IB_ENABLED=false

# ========================================
# Web Intelligence
# ========================================
# Apify (web scraping)
APIFY_TOKEN=
APIFY_ENABLED=true

# ========================================
# Database
# ========================================
# SQLite (Phase 1-2)
DATABASE_URL=sqlite:///./colmena.db
# PostgreSQL (Phase 3+)
# DATABASE_URL=postgresql://user:password@localhost/colmena

# ========================================
# n8n Automation (Phase 3+)
# ========================================
N8N_URL=http://localhost:5678
N8N_API_KEY=
N8N_ENABLED=false

# ========================================
# Logging
# ========================================
LOG_LEVEL=INFO
LOG_FILE=colmena.log

# ========================================
# System
# ========================================
DEBUG=false
ENVIRONMENT=development
